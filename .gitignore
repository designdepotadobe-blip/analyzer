.env
__pycache__/
venv/

# Angular
frontend/node_modules/
frontend/dist/
frontend/.angular/

# throwaway debug artifacts from local runs
scratch_*
*.stackdump

# IDE / tool-local state — not project code
.idea/
.claude/scheduled_tasks.lock

# harvested Discord corpus — raw messages + chart images, pulled by
# discord_harvest.py. Large, and it is someone else's content: keep it local.
corpus/

# validation harness caches (history pickles, scored runs)
.harness/

# pytest's own cache
.pytest_cache/

# analyst notes captured from the hidden feedback box (api.py's /api/notes) —
# personal commentary, reviewed locally on demand, never auto-processed or
# committed. See backend/api.py's `add_note`/`list_notes`.
analyst_notes.jsonl
